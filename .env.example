# Keys for LangGraph-vue (names only). Copy into BOTH files below; both are gitignored.
#   agent/.env           -> read by `langgraphjs dev` (langgraph.json "env": ".env")
#   my-copilot-app/.env  -> sourced by start-all.sh for the runtimes (server.ts BuiltInAgent)
OPENAI_API_KEY=

# Optional overrides (start-all.sh defaults shown in comments)
# LANGGRAPH_DEPLOYMENT_URL=   # default http://localhost:8152
